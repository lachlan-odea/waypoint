rules_version = '2';

// Paste these into the Firestore Rules tab of the Firebase console
// (Build → Firestore Database → Rules). The designers collection is public
// read so the unauthenticated sign-up screen can show the "claim existing
// profile" picker; writes still require a signed-in user. All other
// collections require sign-in for both read and write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /designers/{designerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
    }
    match /projects/{projectId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    // Office locations / time zones. Shared config every signed-in user
    // reads; writes are gated to super users by the Settings UI, the same
    // trust model as the isSuperUser flag on a designer doc.
    match /hubs/{hubId} {
      allow read, write: if request.auth != null;
    }
    // Social calendar posts. One shared plan for the whole team, so the same
    // any-signed-in-user model as projects.
    match /socialPosts/{postId} {
      allow read, write: if request.auth != null;
    }
    // Social calendar configuration (categories, company hashtags). A single
    // document, read by everyone; writes are gated to super users by the
    // Settings UI, like hubs.
    match /socialConfig/{docId} {
      allow read, write: if request.auth != null;
    }
    // Marketing campaigns shown above (and overlaid on) the Social calendar.
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null;
    }
    // Trade shows and conferences on the Events page. One shared list for
    // the events team, same any-signed-in-user model as campaigns.
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }
    // The webinar speaker directory, shared by every signed-in user.
    match /speakers/{speakerId} {
      allow read, write: if request.auth != null;
    }
    // Public copies of campaigns shared as a SharePoint page, keyed by the
    // campaign's random shareToken (see src/campaignExport.ts). The page is
    // opened by people who aren't signed in, so a document can be read by
    // anyone holding its exact token. Listing is refused, so tokens can't be
    // discovered. Signed-in users write them, as the single "json" string
    // the page reads.
    match /campaignPages/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && token.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow delete: if request.auth != null;
    }
    // Public copies of event itineraries shared as a SharePoint page, keyed
    // by the event's itineraryShareToken (see src/itineraryExport.ts). The
    // same arrangement as campaignPages.
    match /itineraryPages/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && token.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow delete: if request.auth != null;

      // Additions readers of the page make to its days, without signing in.
      // Anyone holding the token can add one and read them all (the path
      // itself needs the token, so listing here leaks nothing); nobody can
      // change one once written, and only signed-in users (the organiser,
      // from the itinerary editor) can remove them. Every field is checked
      // and capped so the worst a stray reader can do is leave a note.
      match /additions/{additionId} {
        allow get, list: if true;
        allow create: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/itineraryPages/$(token))
          && request.resource.data.keys().hasOnly([
            'date', 'start', 'end', 'type', 'title', 'details', 'attending', 'name', 'createdAt'
          ])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.start is string
          && request.resource.data.start.matches('^([0-9]{2}:[0-9]{2})?$')
          && request.resource.data.end is string
          && request.resource.data.end.matches('^([0-9]{2}:[0-9]{2})?$')
          && request.resource.data.type in ['meeting', 'stand', 'meal', 'session']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 600
          && request.resource.data.attending is string
          && request.resource.data.attending.size() <= 200
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40;
        allow update: if false;
        allow delete: if request.auth != null;
      }

      // Attendees' own travel and accommodation, entered on the page. The
      // same anyone-with-the-token model, but updates and deletes are
      // allowed too, so a flight change can be corrected and a cancelled
      // trip removed by whoever's travelling; there's no sign-in to tell
      // one attendee from another.
      match /travel/{travelId} {
        allow get, list: if true;
        allow create, update: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/itineraryPages/$(token))
          && request.resource.data.keys().hasOnly([
            'name', 'arrive', 'depart', 'hotel', 'mobile', 'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.arrive is string
          && request.resource.data.arrive.size() <= 200
          && request.resource.data.depart is string
          && request.resource.data.depart.size() <= 200
          && request.resource.data.hotel is string
          && request.resource.data.hotel.size() <= 200
          && request.resource.data.mobile is string
          && request.resource.data.mobile.size() <= 40
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if token.matches('^[0-9a-f]{32}$');
      }
    }
    // My Desk checklist items are private to one person, so unlike the
    // collections above these are locked to their owner rather than to any
    // signed-in user. Reads are constrained by the ownerId == uid filter the
    // client query already sends; writes check the ownerId on the document
    // itself (both the incoming one and, for deletes, the stored one).
    match /deskItems/{deskItemId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
