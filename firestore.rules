rules_version = '2';

// Deploy with `firebase deploy --only firestore:rules` (or paste into the
// Firestore Rules tab of the Firebase console).
//
// Who gets in: anyone can create a Firebase Auth account with the public
// web API key, so being signed in proves nothing. Access goes to members
// only: a signed-in, non-anonymous account with a /designers profile at
// its UID. Only a super user can create a profile, which they do by
// approving an access request (/accessRequests below). Removing someone's
// profile takes their access away. The token-gated public pages further
// down (campaign, itinerary and activity pages, the live event form) are
// the only things reachable without membership.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/designers/$(request.auth.uid));
    }
    // A super user: the isSuperUser flag stored on their own designer doc.
    // The app also treats SUPER_USER_EMAILS (src/constants.ts) as super
    // users, but the rules only trust the stored flag, so a bootstrap admin
    // must have it set (Settings → Super users) to see confidential projects
    // or decide access requests.
    function isSuperUser() {
      return isMember()
        && get(/databases/$(database)/documents/designers/$(request.auth.uid)).data.get("isSuperUser", false) == true;
    }
    // Who may see a confidential project: its assignees and super users.
    function canSeeConfidential(data) {
      return isMember()
        && (request.auth.uid in data.assigneeIds || isSuperUser());
    }

    // Members read every profile; anyone signed in can read their own, so
    // the app can tell whether they're in yet. Creating or deleting a
    // profile grants or removes access, so only super users do either
    // (approving a request, adding a placeholder, removing a user). Super
    // users can see every confidential project, so only a super user may
    // grant or remove the flag; any member can still edit the rest of a
    // profile (name, colour, photo, hub).
    match /designers/{designerId} {
      allow get: if isMember()
        || (request.auth != null && request.auth.uid == designerId);
      allow list: if isMember();
      allow create, delete: if isSuperUser();
      allow update: if isMember()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["isSuperUser"]) || isSuperUser());
    }

    // Requests to join Waypoint, one per account, at the account's UID. The
    // requester can send one only from a verified email at the allowed
    // domain (keep in step with ALLOWED_EMAIL_DOMAIN in src/constants.ts),
    // naming the address on their token, as pending, with nothing else in
    // it. They can read their own to see the answer, and can't change it;
    // super users read them all and approve (with the profile, in the same
    // batch), decline or remove them. A declined request stays, so the
    // person can't simply ask again until a super user removes it.
    match /accessRequests/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isSuperUser();
      allow list, update, delete: if isSuperUser();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.+@wisetechglobal[.]com')
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
    }
    match /workspaces/{workspaceId} {
      allow read, write: if isMember();
    }
    // A confidential project never lives here: it's in
    // /confidentialProjects below, so a document flagged confidential can't
    // be written to the collection every signed-in user can read.
    match /projects/{projectId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.get("confidential", false) != true;
    }
    // Confidential Comms projects: readable and writable only by their
    // assignees and super users. The app's listener asks for exactly that
    // (array-contains on assigneeIds, or everything for a super user), which
    // is why a query here can be allowed at all. Writes must keep the flag
    // and must leave the writer able to see the result, so nobody can mark a
    // project they're not on confidential.
    match /confidentialProjects/{projectId} {
      allow read, delete: if canSeeConfidential(resource.data);
      allow create: if canSeeConfidential(request.resource.data)
        && request.resource.data.confidential == true;
      allow update: if canSeeConfidential(resource.data)
        && request.resource.data.confidential == true;
    }
    match /notifications/{notificationId} {
      allow read, write: if isMember();
    }
    // Office locations / time zones. Shared config every signed-in user
    // reads; writes are gated to super users by the Settings UI, the same
    // trust model as the isSuperUser flag on a designer doc.
    match /hubs/{hubId} {
      allow read, write: if isMember();
    }
    // Social calendar posts. One shared plan for the whole team, so the same
    // any-signed-in-user model as projects.
    match /socialPosts/{postId} {
      allow read, write: if isMember();
    }
    // Social calendar configuration (categories, company hashtags). A single
    // document, read by everyone; writes are gated to super users by the
    // Settings UI, like hubs.
    match /socialConfig/{docId} {
      allow read, write: if isMember();
    }
    // Marketing campaigns shown above (and overlaid on) the Social calendar.
    match /campaigns/{campaignId} {
      allow read, write: if isMember();
    }
    // Trade shows and conferences on the Events page. One shared list for
    // the events team, same any-signed-in-user model as campaigns.
    match /events/{eventId} {
      allow read, write: if isMember();
    }
    // The one marketing-activity page for SharePoint: every campaign,
    // webinar and event as a single JSON string, readable by anyone with
    // the exact token (see src/activityExport.ts). Larger than a campaign
    // page, so a higher size cap; Firestore's own limit is 1 MiB.
    match /activityPages/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember()
        && token.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 950000;
      allow delete: if isMember();

      // Deliverables other teams add to a campaign on the page, without
      // signing in. The same anyone-with-the-token model as an itinerary's
      // travel entries: whoever holds the page can add one, correct it
      // (the link, the date, delivered or not) and take it off again.
      // Every field is checked and capped, the team must be one of the
      // known ones (the list in src/activityExport.ts), and a deliverable
      // can't be moved to another campaign.
      match /deliverables/{deliverableId} {
        allow get, list: if true;
        allow create, update: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/activityPages/$(token))
          && request.resource.data.keys().hasOnly([
            'campaignId', 'team', 'title', 'date', 'url', 'workItemUrl', 'done', 'name',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.campaignId is string
          && request.resource.data.campaignId.size() > 0
          && request.resource.data.campaignId.size() <= 80
          && (resource == null || request.resource.data.campaignId == resource.data.campaignId)
          && request.resource.data.team in [
            'Product', 'Commercial Finance', 'Marketing', 'eLearning', 'Sales', 'Languages',
            'Customer Experience', 'Partner Management', 'Communications', 'Legal and Licensing'
          ]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.date is string
          && request.resource.data.date.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 1000
          && request.resource.data.url.matches('^(https?://.+)?$')
          // The work item's link came later, so a copy of the page from
          // before it can still save without one.
          && (!('workItemUrl' in request.resource.data)
            || (request.resource.data.workItemUrl is string
              && request.resource.data.workItemUrl.size() <= 1000
              && request.resource.data.workItemUrl.matches('^(https?://.+)?$')))
          && request.resource.data.done is bool
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if token.matches('^[0-9a-f]{32}$');
      }

      // Who owns a campaign in each team, shown under its Details. One
      // document per campaign and team, written the same way.
      match /teamOwners/{ownerId} {
        allow get, list: if true;
        allow create, update: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/activityPages/$(token))
          && request.resource.data.keys().hasOnly(['campaignId', 'team', 'owner', 'updatedAt'])
          && request.resource.data.campaignId is string
          && request.resource.data.campaignId.size() > 0
          && request.resource.data.campaignId.size() <= 80
          && request.resource.data.team in [
            'Product', 'Commercial Finance', 'Marketing', 'eLearning', 'Sales', 'Languages',
            'Customer Experience', 'Partner Management', 'Communications', 'Legal and Licensing'
          ]
          && request.resource.data.owner is string
          && request.resource.data.owner.size() > 0
          && request.resource.data.owner.size() <= 120
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if token.matches('^[0-9a-f]{32}$');
      }
    }
    // App-wide settings documents, such as the activity page's token and
    // SharePoint link. Signed-in users only.
    match /settings/{settingId} {
      allow read, write: if isMember();
    }
    // The webinar speaker directory, shared by every signed-in user.
    match /speakers/{speakerId} {
      allow read, write: if isMember();
    }
    // The marketing team's Big Rocks (strategic priorities). Read by every
    // signed-in user; written from Settings by super users, gated in the
    // UI like the other shared configuration.
    match /bigRocks/{rockId} {
      allow read, write: if isMember();
    }
    // The team's shared Tools (shortcuts shown as tiles on the Tools page).
    // Read and added to by every signed-in user — anyone on the team can
    // add a tool that's useful for everyone.
    match /tools/{toolId} {
      allow read, write: if isMember();
    }
    // Public copies of campaigns shared as a SharePoint page, keyed by the
    // campaign's random shareToken (see src/campaignExport.ts). The page is
    // opened by people who aren't signed in, so a document can be read by
    // anyone holding its exact token. Listing is refused, so tokens can't be
    // discovered. Signed-in users write them, as the single "json" string
    // the page reads.
    match /campaignPages/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember()
        && token.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow delete: if isMember();
    }
    // Public copies of event itineraries shared as a SharePoint page, keyed
    // by the event's itineraryShareToken (see src/itineraryExport.ts). The
    // same arrangement as campaignPages.
    match /itineraryPages/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember()
        && token.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow delete: if isMember();

      // Additions readers of the page make to its days, without signing in.
      // Anyone holding the token can add one and read them all (the path
      // itself needs the token, so listing here leaks nothing); nobody can
      // change one once written, and only signed-in users (the organiser,
      // from the itinerary editor) can remove them. Every field is checked
      // and capped so the worst a stray reader can do is leave a note.
      match /additions/{additionId} {
        allow get, list: if true;
        allow create: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/itineraryPages/$(token))
          && request.resource.data.keys().hasOnly([
            'date', 'start', 'end', 'type', 'title', 'details', 'attending', 'name', 'createdAt'
          ])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.start is string
          && request.resource.data.start.matches('^([0-9]{2}:[0-9]{2})?$')
          && request.resource.data.end is string
          && request.resource.data.end.matches('^([0-9]{2}:[0-9]{2})?$')
          && request.resource.data.type in ['meeting', 'stand', 'meal', 'session']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 600
          && request.resource.data.attending is string
          && request.resource.data.attending.size() <= 200
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40;
        allow update: if false;
        allow delete: if isMember();
      }

      // Attendees' own travel and accommodation, entered on the page. The
      // same anyone-with-the-token model, but updates and deletes are
      // allowed too, so a flight change can be corrected and a cancelled
      // trip removed by whoever's travelling; there's no sign-in to tell
      // one attendee from another.
      match /travel/{travelId} {
        allow get, list: if true;
        allow create, update: if token.matches('^[0-9a-f]{32}$')
          && exists(/databases/$(database)/documents/itineraryPages/$(token))
          && request.resource.data.keys().hasOnly([
            'name', 'arrive', 'depart', 'hotel', 'mobile', 'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.arrive is string
          && request.resource.data.arrive.size() <= 200
          && request.resource.data.depart is string
          && request.resource.data.depart.size() <= 200
          && request.resource.data.hotel is string
          && request.resource.data.hotel.size() <= 200
          && request.resource.data.mobile is string
          && request.resource.data.mobile.size() <= 40
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if token.matches('^[0-9a-f]{32}$');
      }
    }
    // Requests for the Live Events team's support, sent in by the Live
    // event request form on SharePoint (src/liveEventRequestExport.ts).
    // The form isn't signed in, so a create is taken from anyone, but only
    // when it carries the current intake token from /settings/liveEventIntake
    // (rotating the token retires every copy of the form), only as the
    // fixed set of string fields the form writes, each capped, and only as
    // pending. Nothing unauthenticated can read a request back; the Video
    // team reads, decides on and removes them from Waypoint.
    match /liveEventRequests/{requestId} {
      allow read: if isMember();
      allow create: if isMember()
        || (request.resource.data.keys().hasOnly([
          'json', 'eventName', 'requesterName', 'requesterEmail', 'eventDate',
          'createdAt', 'status', 'intakeToken'
        ])
        && request.resource.data.intakeToken is string
        && request.resource.data.intakeToken.matches('^[0-9a-f]{32}$')
        && request.resource.data.intakeToken
          == get(/databases/$(database)/documents/settings/liveEventIntake).data.token
        && request.resource.data.status == 'pending'
        && request.resource.data.json is string
        && request.resource.data.json.size() > 0
        && request.resource.data.json.size() < 200000
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() > 0
        && request.resource.data.eventName.size() <= 160
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 80
        && request.resource.data.requesterEmail is string
        && request.resource.data.requesterEmail.size() <= 120
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40);
      allow update, delete: if isMember();
    }
    // Periods the Live Events Team isn't taking bookings for, managed from
    // the Video board.
    match /liveEventBlackouts/{blackoutId} {
      allow read, write: if isMember();
    }
    // What a copy of the request form reads back: the blackouts, kept
    // under the current intake token so only the form (which carries the
    // token) can find them. Waypoint rewrites it whenever the blackouts or
    // the token change.
    match /liveEventPublic/{token} {
      allow read: if true;
      allow write: if isMember();
    }
    // Feature ideas and bug reports from Settings → Suggest a feature
    // (src/components/SuggestFeatureModal.tsx). Any signed-in user sends
    // one; super users review, update and remove them, gated in the UI like
    // the other shared configuration.
    match /suggestions/{suggestionId} {
      allow read, write: if isMember();
    }
    // LinkedIn (functions/src/linkedin.ts). The connected account's token
    // lives in /linkedinPrivate and is only ever touched by the functions,
    // which don't go through these rules: no client may read or write it.
    // What the functions publish for the app (the connection's status, each
    // page's followers and 30 days, each post's results) is read-only to
    // signed-in users, so nobody can plant numbers or fake a connection.
    // Which page a channel posts to is /settings/linkedin, above.
    match /linkedinPrivate/{docId} {
      allow read, write: if false;
    }
    match /linkedin/{docId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /linkedinPostStats/{statId} {
      allow read: if isMember();
      allow write: if false;
    }
    // My Desk checklist items are private to one person, so unlike the
    // collections above these are locked to their owner rather than to any
    // signed-in user. Reads are constrained by the ownerId == uid filter the
    // client query already sends; writes check the ownerId on the document
    // itself (both the incoming one and, for deletes, the stored one).
    match /deskItems/{deskItemId} {
      allow read: if isMember()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isMember()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMember()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
